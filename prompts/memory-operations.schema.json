{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory patch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "update", "remove", "move", "merge", "upsert"]
          },
          "target": {
            "type": "string",
            "enum": ["timeline_block", "person", "place", "fact"]
          },
          "target_id": { "type": ["string", "null"] },
          "after_id": { "type": ["string", "null"] },
          "merge_from_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "time_label": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] },
          "text": { "type": ["string", "null"] },
          "value": {
            "type": ["string", "number", "boolean", "null"]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["op", "target"]
      }
    }
  },
  "required": ["operations"]
}
